# Public origin of the site, without a trailing slash. Read at build time: canonical,
# hreflang, og:image, JSON-LD and sitemap URLs are relative without it.
NUXT_PUBLIC_SITE_URL=

# Analytics (PostHog project token and API host, e.g. https://eu.i.posthog.com)
NUXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NUXT_PUBLIC_POSTHOG_HOST=

# SMTP account the contact form sends from (port 465 = TLS, 587 = STARTTLS required).
# Read at build time; on the server they can be overridden at runtime as NUXT_MAIL_HOST, etc.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Address that receives the contact form messages
CONTACT_MAIL=
